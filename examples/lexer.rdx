                if chr_at(src, start + 1) == "y" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "t" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  byt  \"byt\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
