// ── lexer.rdx ─────────────────────────────────────────────────────
// Step B: Stage 2 Self-Hosting Prototype (Lexer)
// Matches C lexer functionality identically.

make is_digit(chr c) -> num {
    if c == "0" { ret 1 }
    if c == "1" { ret 1 }
    if c == "2" { ret 1 }
    if c == "3" { ret 1 }
    if c == "4" { ret 1 }
    if c == "5" { ret 1 }
    if c == "6" { ret 1 }
    if c == "7" { ret 1 }
    if c == "8" { ret 1 }
    if c == "9" { ret 1 }
    ret 0
}

make is_space(chr c) -> num {
    if c == " " { ret 1 }
    if c == "\n" { ret 1 }
    if c == "\r" { ret 1 }
    if c == "\t" { ret 1 }
    ret 0
}

make is_alpha(chr c) -> num {
    if c == "a" { ret 1 }
    if c == "b" { ret 1 }
    if c == "c" { ret 1 }
    if c == "d" { ret 1 }
    if c == "e" { ret 1 }
    if c == "f" { ret 1 }
    if c == "g" { ret 1 }
    if c == "h" { ret 1 }
    if c == "i" { ret 1 }
    if c == "j" { ret 1 }
    if c == "k" { ret 1 }
    if c == "l" { ret 1 }
    if c == "m" { ret 1 }
    if c == "n" { ret 1 }
    if c == "o" { ret 1 }
    if c == "p" { ret 1 }
    if c == "q" { ret 1 }
    if c == "r" { ret 1 }
    if c == "s" { ret 1 }
    if c == "t" { ret 1 }
    if c == "u" { ret 1 }
    if c == "v" { ret 1 }
    if c == "w" { ret 1 }
    if c == "x" { ret 1 }
    if c == "y" { ret 1 }
    if c == "z" { ret 1 }
    if c == "A" { ret 1 }
    if c == "B" { ret 1 }
    if c == "C" { ret 1 }
    if c == "D" { ret 1 }
    if c == "E" { ret 1 }
    if c == "F" { ret 1 }
    if c == "G" { ret 1 }
    if c == "H" { ret 1 }
    if c == "I" { ret 1 }
    if c == "J" { ret 1 }
    if c == "K" { ret 1 }
    if c == "L" { ret 1 }
    if c == "M" { ret 1 }
    if c == "N" { ret 1 }
    if c == "O" { ret 1 }
    if c == "P" { ret 1 }
    if c == "Q" { ret 1 }
    if c == "R" { ret 1 }
    if c == "S" { ret 1 }
    if c == "T" { ret 1 }
    if c == "U" { ret 1 }
    if c == "V" { ret 1 }
    if c == "W" { ret 1 }
    if c == "X" { ret 1 }
    if c == "Y" { ret 1 }
    if c == "Z" { ret 1 }
    if c == "_" { ret 1 }
    ret 0
}

make is_alnum(chr c) -> num {
    if is_alpha(c) == 1 { ret 1 }
    if is_digit(c) == 1 { ret 1 }
    ret 0
}

make tokenize(chr src) {
    num length = len(src)
    num pos = 0
    num token_count = 0
    num line = 1
    
    call("=== Tokens ===")

    loop {
        if (pos >= length) {
            break
        }
        
        chr current = chr_at(src, pos)
        num handled = 0
        
        if handled == 0 {
            if is_space(current) == 1 {
                if current == "\n" { line = line + 1 }
                pos = pos + 1
                handled = 1
            }
        }

        // Comment check
        if handled == 0 {
            if current == "/" {
                if (pos + 1 < length) {
                    chr next = chr_at(src, pos + 1)
                    if next == "/" {
                        loop {
                            if (pos >= length) { break }
                            chr c = chr_at(src, pos)
                            if c == "\n" { break }
                            pos = pos + 1
                        }
                        handled = 1
                    }
                }
            }
        }

        num cur_line = line + 0

        // String check
        if handled == 0 {
            if current == "\"" {
                pos = pos + 1
                chr str_val = ""
                loop {
                    if (pos >= length) { break }
                    chr c = chr_at(src, pos)
                    if c == "\"" {
                        pos = pos + 1
                        break
                    }
                    if c == "\n" { line = line + 1 }
                    str_val = concat(str_val, c)
                    pos = pos + 1
                }
                call("" ["  [", token_count, "] L", cur_line, "  STR_LIT  \"", str_val, "\""])
                token_count = token_count + 1
                handled = 1
            }
        }

        if handled == 0 {
            if is_digit(current) == 1 {
                // It's a number (flt or num)
                num is_flt = 0
                chr num_val = ""
                loop {
                    if (pos >= length) { break }
                    chr n = chr_at(src, pos)
                    num done_digit = 0
                    if is_digit(n) == 1 {
                        num_val = concat(num_val, n)
                        pos = pos + 1
                        done_digit = 1
                    }
                    if done_digit == 0 {
                        if n == "." {
                            if (pos + 1 < length) {
                                chr n2 = chr_at(src, pos + 1)
                                if n2 != "." {
                                    if is_digit(n2) == 1 {
                                        is_flt = 1
                                        num_val = concat(num_val, n)
                                        num_val = concat(num_val, n2)
                                        pos = pos + 2
                                        done_digit = 1
                                    }
                                }
                            }
                        }
                    }
                    if done_digit == 0 {
                        break
                    }
                }
                if is_flt == 1 {
                    call("" ["  [", token_count, "] L", cur_line, "  FLT_LIT  \"", num_val, "\""])
                } else {
                    call("" ["  [", token_count, "] L", cur_line, "  NUM_LIT  \"", num_val, "\""])
                }
                token_count = token_count + 1
                handled = 1
            }
        }

        if handled == 0 {
            if is_alpha(current) == 1 {
                // It's an identifier or keyword
                num start = pos + 0
                num start_line = cur_line
                chr c0 = ""
                c0 = current
                chr id_val = ""
                loop {
                    if (pos >= length) { break }
                    chr n = chr_at(src, pos)
                    if is_alnum(n) == 0 { break }
                    id_val = concat(id_val, n)
                    pos = pos + 1
                }
                num len_val = pos - start
                
            num is_kw = 0
            if (start + 0 < length) {
              if c0 == "n" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "u" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "m" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  num  \"num\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "c" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "h" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "r" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  chr  \"chr\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "f" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "l" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "t" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  flt  \"flt\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "b" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "l" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "o" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  blo  \"blo\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "d" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "o" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "b" {
                  if len_val == 3 {
                    call("" ["  [", token_count, "] L", start_line, "  dob  \"dob\""])
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "b" {
