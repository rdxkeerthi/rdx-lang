// Prime Number Finder in RDX v3.0
println("==========================================")
println("        RDX Prime Number Finder           ")
println("==========================================")

fn is_prime(n) {
    if n < 2 { return false }
    if n == 2 { return true }
    if n % 2 == 0 { return false }
    let d = 3
    while d * d <= n {
        if n % d == 0 { return false }
        d = d + 2
    }
    return true
}

println("=== Checking Numbers 2 to 20 ===")
for n in range(19) {
    let num = n + 2
    if is_prime(num) {
        println(str(num) + " -> PRIME")
    } else {
        println(str(num) + " -> composite")
    }
}

println("")
println("=== First 10 Primes ===")
let primes = []
let candidate = 2
while len(primes) < 10 {
    if is_prime(candidate) {
        append(primes, candidate)
    }
    candidate = candidate + 1
}
println("Primes: " + str(primes))
