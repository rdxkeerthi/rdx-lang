names = ["Alice", "Bob", "Charlie"]
append(names, "Diana")
append(names, "Eve")
print "Names:", names
print "Length:", len(names)
print "First:", names[0]
print "Last:", names[-1]

// Sorting (manual — bubble sort)
fn bubble_sort(lst) {
    n = len(lst)
    i = 0
    while i < n {
        j = 0
        while j < n - i - 1 {
            if lst[j] > lst[j + 1] {
                tmp = lst[j]
                lst[j] = lst[j + 1]
                lst[j + 1] = tmp
            }
            j += 1
        }
        i += 1
    }
    return lst
}

nums = [64, 34, 25, 12, 22, 11, 90]
print "Unsorted:", nums
sorted_nums = bubble_sort(nums)
print "Sorted:  ", sorted_nums
print ""

// ══════════════════════════════════════════════════════════
// SECTION 8: Cyber Forensics Builtins
// ══════════════════════════════════════════════════════════
print "[ 8 ] CYBER FORENSICS BUILTINS"
print "-" * 40

// IP Analysis
test_ips = ["192.168.1.1", "8.8.8.8", "10.0.0.5", "172.16.1.1", "203.0.113.99"]
print "IP Analysis:"
for ip in test_ips {
    is_priv = ip.is_private(ip)
    // Note: ip.is_private is builtin, use directly
}

for ip in test_ips {
    if ip.is_valid(ip) {
        if ip.is_private(ip) {
            print "  [PRIVATE]", ip
        } else {
            print "  [PUBLIC] ", ip
        }
    }
}

// Hashing
sample = "critical_malware_payload_2026"
print ""
print "Hashing sample:", sample
print "  MD5:    ", hash.md5(sample)
print "  SHA1:   ", hash.sha1(sample)
print "  SHA256: ", hash.sha256(sample)

// Port profiling
print ""
print "Port Risk Profiling:"
high_risk_ports = [23, 445, 3389, 6379, 9200]
for port in high_risk_ports {
    svc  = net.port_name(port)
    risk = net.port_risk(port)
    print "  Port", port, "(" + svc + "):", risk
}

// Log Attack Detection
print ""
print "Attack Vector Detection:"
logs = [
    "GET /index.php?id=1' OR '1'='1 HTTP/1.1",
    "<script>alert('XSS')</script>",
    "GET /../../../../etc/passwd HTTP/1.1",
    "cmd.exe /c whoami",
    "GET /index.html HTTP/1.1"
]
for log_line in logs {
    attack = log.detect_attack(log_line)
    if len(attack) > 0 {
        print "  [ATTACK]  ", attack
    } else {
        print "  [CLEAN]   Benign request"
    }
}

