print "Upper:", s.trim().upper()
print "Contains 'Security':", s.contains("Security")
print "Replace 'Security' -> 'Forensics':", s.trim().replace("Security", "Forensics")

csv_row = "John,Doe,35,Engineer"
fields = csv_row.split(",")
print "CSV split:", fields
print "First name:", fields[0]
