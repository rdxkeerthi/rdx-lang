// ══════════════════════════════════════════════════════════
// SECTION 1: Basic Data Types
// ══════════════════════════════════════════════════════════
print "[ 1 ] DATA TYPES"
print "-" * 40

integer_val  = 42
float_val    = 3.14159
string_val   = "Hello, RDX!"
bool_val     = true
nil_val      = nil
list_val     = [1, 2, 3, "four", true]

print "Integer:", integer_val, "type:", type(integer_val)
print "Float:  ", float_val,   "type:", type(float_val)
print "String: ", string_val,  "type:", type(string_val)
print "Bool:   ", bool_val,    "type:", type(bool_val)
print "Nil:    ", nil_val,     "type:", type(nil_val)
print "List:   ", list_val,    "type:", type(list_val)
print ""

// ══════════════════════════════════════════════════════════
// SECTION 2: Control Flow
// ══════════════════════════════════════════════════════════
print "[ 2 ] CONTROL FLOW (if / elif / else)"
print "-" * 40

score = 82
if score >= 90 {
    grade = "A"
} elif score >= 80 {
    grade = "B"
} elif score >= 70 {
    grade = "C"
} else {
    grade = "F"
}
print "Score:", score, "-> Grade:", grade
print ""

// ══════════════════════════════════════════════════════════
// SECTION 3: Loops
// ══════════════════════════════════════════════════════════
print "[ 3 ] LOOPS (for / while / break / continue)"
print "-" * 40

// for-in loop
fruits = ["apple", "banana", "cherry", "date"]
print "Fruits:"
for fruit in fruits {
    print "  -", fruit
}

// range loop
print "Even numbers 0-10:"
evens = []
for i in range(0, 11) {
    if i % 2 == 0 {
        append(evens, i)
    }
}
print " ", evens

// while with break
print "While loop (stops at 7):"
n = 0
result_list = []
while n < 20 {
    if n == 7 { break }
    append(result_list, n)
    n += 1
}
print " ", result_list

// continue
print "Skip multiples of 3:"
skipped = []
for i in range(1, 16) {
    if i % 3 == 0 { continue }
    append(skipped, i)
}
print " ", skipped
print ""

// ══════════════════════════════════════════════════════════
// SECTION 4: Functions
// ══════════════════════════════════════════════════════════
print "[ 4 ] USER-DEFINED FUNCTIONS"
print "-" * 40

fn square(x)        { return x * x }
fn cube(x)          { return x * x * x }
fn is_even(n)       { return n % 2 == 0 }
fn clamp(v, lo, hi) {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

print "square(7) =", square(7)
print "cube(4) =", cube(4)
print "is_even(10) =", is_even(10)
print "is_even(11) =", is_even(11)
print "clamp(-5, 0, 100) =", clamp(-5, 0, 100)
print "clamp(150, 0, 100) =", clamp(150, 0, 100)
print "clamp(42, 0, 100) =", clamp(42, 0, 100)
print ""

// ══════════════════════════════════════════════════════════
