                          tok_val[token_count] = "extern"
                          tok_line[token_count] = start_line
                          is_kw = 1
                        }
                        }
                      }
                      }
                    }
                    }
                  }
                  }
                }
                }
              }
              }
            }
            if is_kw == 0 {
                tok_type[token_count] = 45
                tok_val[token_count] = id_val
                tok_line[token_count] = start_line
            }
                token_count = token_count + 1
                handled = 1
            }
        }
        if handled == 0 {
            if current == "+" {
                if handled == 0 {
                    tok_type[token_count] = 46
                    tok_val[token_count] = "+"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "-" {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == ">" {
                        tok_type[token_count] = 58
                        tok_val[token_count] = "->"
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 47
                    tok_val[token_count] = "-"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "*" {
                if handled == 0 {
                    tok_type[token_count] = 48
                    tok_val[token_count] = "*"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "/" {
                if handled == 0 {
                    tok_type[token_count] = 49
                    tok_val[token_count] = "/"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "%" {
                if handled == 0 {
                    tok_type[token_count] = 50
                    tok_val[token_count] = "%"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "<" {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == "=" {
                        tok_type[token_count] = 55
                        tok_val[token_count] = "<="
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 53
                    tok_val[token_count] = "<"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == ">" {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == "=" {
                        tok_type[token_count] = 56
                        tok_val[token_count] = ">="
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 54
                    tok_val[token_count] = ">"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "=" {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == "=" {
                        tok_type[token_count] = 51
                        tok_val[token_count] = "=="
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 57
                    tok_val[token_count] = "="
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "!" {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == "=" {
                        tok_type[token_count] = 52
                        tok_val[token_count] = "!="
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 71
                    tok_val[token_count] = "!"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "?" {
                if handled == 0 {
                    tok_type[token_count] = 43
                    tok_val[token_count] = "?"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "(" {
                if handled == 0 {
                    tok_type[token_count] = 60
                    tok_val[token_count] = "("
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == ")" {
                if handled == 0 {
                    tok_type[token_count] = 61
                    tok_val[token_count] = ")"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "{" {
                if handled == 0 {
                    tok_type[token_count] = 62
                    tok_val[token_count] = "{"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "}" {
                if handled == 0 {
                    tok_type[token_count] = 63
                    tok_val[token_count] = "}"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "[" {
                if handled == 0 {
                    tok_type[token_count] = 64
                    tok_val[token_count] = "["
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "]" {
                if handled == 0 {
                    tok_type[token_count] = 65
                    tok_val[token_count] = "]"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == ";" {
                if handled == 0 {
                    tok_type[token_count] = 66
                    tok_val[token_count] = ";"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "," {
                if handled == 0 {
                    tok_type[token_count] = 67
                    tok_val[token_count] = ","
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == "." {
                if (pos + 1 < length) {
                    if chr_at(src, pos + 1) == "." {
                        tok_type[token_count] = 59
                        tok_val[token_count] = ".."
                        tok_line[token_count] = cur_line
                        pos = pos + 2
                        token_count = token_count + 1
                        handled = 1
                    }
                }
                if handled == 0 {
                    tok_type[token_count] = 68
                    tok_val[token_count] = "."
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            if current == ":" {
                if handled == 0 {
                    tok_type[token_count] = 69
                    tok_val[token_count] = ":"
                    tok_line[token_count] = cur_line
                    pos = pos + 1
                    token_count = token_count + 1
                    handled = 1
                }
            }
        }
        if handled == 0 {
            tok_type[token_count] = 71 // UNKNOWN
            tok_val[token_count] = current
            tok_line[token_count] = cur_line
            pos = pos + 1
            token_count = token_count + 1
        }
    }
    tok_type[token_count] = 70 // EOF
    tok_val[token_count] = ""
    tok_line[token_count] = line
    tok_count = token_count + 1
}

make cur_type() -> num { ret tok_type[tok_pos] }
make cur_val() -> chr { ret tok_val[tok_pos] }
make cur_line() -> num { ret tok_line[tok_pos] }

make peek_type(num off) -> num {
    num i = tok_pos + off
    if (i < tok_count) { ret tok_type[i] }
    ret tok_type[tok_count - 1]
}

make advance() {
    if tok_pos < tok_count - 1 {
        tok_pos = tok_pos + 1
    }
}

make check(num t) -> num {
    if cur_type() == t { ret 1 }
    ret 0
}

make match_tok(num t) -> num {
    if check(t) == 1 {
        advance()
        ret 1
    }
    ret 0
}

make expect(num t, chr msg) {
    if check(t) == 1 {
        advance()
    } else {
        had_error = 1
        call("" ["[RDX PARSE ERROR] line ", cur_line(), ": ", msg, " (got '", cur_val(), "')"])
    }
}

make new_node(num type, num line) -> num {
    num n = node_count
    node_count = node_count + 1
    node_type[n] = type
    ret n
}

// ========================
// Parser Implementation
// ========================

// (We need to declare forward somehow or order properly)
// RDX requires no forward declarations, functions are global, but let's order them properly.

// parse_primary -> parse_unary -> parse_mul -> parse_add -> parse_cmp -> parse_expr

// But wait, there is circular dependency! parse_primary -> parse_expr.
// In RDX, functions don't need forward declarations, they are hoisted!

make parse_expr() -> num {
    num left = parse_cmp()
    loop {
        num stop = 1
        if check(24) == 1 { stop = 0 } // TOK_AND
        if check(25) == 1 { stop = 0 } // TOK_OR
        if stop == 1 { break }
        chr op = cur_val()
        num op_line = cur_line()
        advance()
        num right = parse_cmp()
        num n = new_node(12, op_line) // NODE_BINARY_OP
        node_op[n] = op
        node_left[n] = left
        node_right[n] = right
        left = n
    }
    ret left
}

make parse_cmp() -> num {
    num left = parse_add()
    loop {
        num stop = 1
        if check(51) == 1 { stop = 0 } // TOK_EQ
        if check(52) == 1 { stop = 0 } // TOK_NEQ
        if check(53) == 1 { stop = 0 } // TOK_LT
        if check(54) == 1 { stop = 0 } // TOK_GT
        if check(55) == 1 { stop = 0 } // TOK_LTE
        if check(56) == 1 { stop = 0 } // TOK_GTE
        if stop == 1 { break }
        chr op = cur_val()
        num op_line = cur_line()
        advance()
        num right = parse_add()
        num n = new_node(12, op_line) // NODE_BINARY_OP
        node_op[n] = op
        node_left[n] = left
        node_right[n] = right
        left = n
    }
    ret left
}

make parse_add() -> num {
    num left = parse_mul()
    loop {
        num stop = 1
        if check(46) == 1 { stop = 0 } // TOK_PLUS
        if check(47) == 1 { stop = 0 } // TOK_MINUS
        if stop == 1 { break }
        chr op = cur_val()
        num op_line = cur_line()
        advance()
        num right = parse_mul()
        num n = new_node(12, op_line) // NODE_BINARY_OP
        node_op[n] = op
        node_left[n] = left
        node_right[n] = right
        left = n
    }
    ret left
}

make parse_mul() -> num {
    num left = parse_unary()
    loop {
        num stop = 1
        if check(48) == 1 { stop = 0 } // TOK_STAR
        if check(49) == 1 { stop = 0 } // TOK_SLASH
        if check(50) == 1 { stop = 0 } // TOK_PERCENT
        if stop == 1 { break }
        chr op = cur_val()
        num op_line = cur_line()
        advance()
        num right = parse_unary()
        num n = new_node(12, op_line) // NODE_BINARY_OP
        node_op[n] = op
        node_left[n] = left
        node_right[n] = right
        left = n
    }
    ret left
}

make parse_unary() -> num {
    if check(26) == 1 { // TOK_NOT
        num line = cur_line()
        advance()
        num n = new_node(12, line) // NODE_BINARY_OP
        node_op[n] = "not"
        node_left[n] = parse_unary()
        ret n
    }
    if check(47) == 1 { // TOK_MINUS
        num line = cur_line()
        advance()
        num n = new_node(12, line) // NODE_BINARY_OP
        node_op[n] = "neg"
        node_left[n] = parse_unary()
        ret n
    }
    ret parse_primary()
}

make my_parse_num(chr s) -> num {
    // simplified number parsing
    // RDX doesn't have a str_to_num built-in yet, wait maybe it does? 
    // In src/parser.c: "while (*s >= '0' && *s <= '9') v = v*10 + (*s++ - '0');"
    num v = 0
    num i = 0
    num len_s = len(s)
    loop {
        if i >= len_s { break }
        chr c = chr_at(s, i)
        num d = -1
        if c == "0" { d = 0 }
        if c == "1" { d = 1 }
        if c == "2" { d = 2 }
        if c == "3" { d = 3 }
        if c == "4" { d = 4 }
        if c == "5" { d = 5 }
        if c == "6" { d = 6 }
        if c == "7" { d = 7 }
        if c == "8" { d = 8 }
        if c == "9" { d = 9 }
        if d >= 0 { v = v * 10 + d }
        i = i + 1
    }
    ret v
}

make parse_primary_inner() -> num {
    num t = cur_type()
    num line = cur_line()
    
    if t == 0 { // TOK_NUM_LIT
        num n = new_node(13, line) // NODE_LITERAL_NUM
        node_ival[n] = my_parse_num(cur_val())
        advance()
        ret n
    }
    if t == 1 { // TOK_STR_LIT
        num n = new_node(14, line) // NODE_LITERAL_STR
        node_sval[n] = cur_val()
        advance()
        ret n
    }
    if t == 2 { // TOK_FLT_LIT
        num n = new_node(15, line) // NODE_LITERAL_FLT
        node_sval[n] = cur_val()
        advance()
        ret n
    }
    if t == 27 { // TOK_TRUE
        num n = new_node(13, line)
        node_ival[n] = 1
        advance()
        ret n
    }
    if t == 28 { // TOK_FALSE
        num n = new_node(13, line)
        node_ival[n] = 0
        advance()
        ret n
    }
    if t == 64 { // TOK_LBRACKET
        advance()
        num n = new_node(20, line) // NODE_ARRAY
        loop {
            if check(65) == 1 { break } // TOK_RBRACKET
            if check(70) == 1 { break } // TOK_EOF
            if node_child_count[n] > 0 { expect(67, "expected ','") }
            num c = parse_expr()
            node_children[n * 16 + node_child_count[n]] = c
            node_child_count[n] = node_child_count[n] + 1
        }
        expect(65, "expected ']'")
        ret n
    }
    
    if t == 32 { // TOK_CALL
        advance()
        num n = new_node(11, line) // NODE_SYS_CALL
        expect(60, "expected '(' after 'call'")
        if check(1) == 1 { // TOK_STR_LIT
            node_sval[n] = cur_val()
            advance()
            if check(64) == 1 { // TOK_LBRACKET
                node_left[n] = parse_primary()
            }
        } else {
            num arr = new_node(20, line) // ARRAY
            num c = parse_expr()
            node_children[arr * 16] = c
            node_child_count[arr] = 1
            node_left[n] = arr
        }
        expect(61, "expected ')'")
        ret n
    }
    
    // Identifier handling (ident, fn call, member access, index)
    num is_type = 0
    if t >= 3 { if t <= 8 { is_type = 1 } } // TOK_NUM to TOK_BYT
    
    if t == 45 { is_type = 1 } // TOK_IDENT
    if is_type == 1 {
        chr name = cur_val()
        advance()
        
        if check(60) == 1 { // TOK_LPAREN
            advance()
            num n = new_node(10, line) // NODE_FN_CALL
            node_sval[n] = name
            loop {
                if check(61) == 1 { break } // TOK_RPAREN
                if check(70) == 1 { break } // TOK_EOF
                if node_child_count[n] > 0 { expect(67, "expected ','") }
                num c = parse_expr()
                node_children[n * 16 + node_child_count[n]] = c
                node_child_count[n] = node_child_count[n] + 1
            }
            expect(61, "expected ')'")
            ret n
        }
        
        if check(64) == 1 { // TOK_LBRACKET
            advance()
            num n = new_node(26, line) // NODE_INDEX
            node_sval[n] = name
            node_left[n] = parse_expr()
            expect(65, "expected ']'")
            ret n
        }
        
        if check(68) == 1 { // TOK_DOT
            advance()
            chr field = cur_val()
            expect(45, "expected field name")
            if check(60) == 1 { // Method call (approx)
                advance()
                num n = new_node(10, line) // NODE_FN_CALL
                node_sval[n] = concat(concat(name, "."), field)
                loop {
                    if check(61) == 1 { break }
                    if check(70) == 1 { break }
                    if node_child_count[n] > 0 { expect(67, "expected ','") }
                    num c = parse_expr()
                    node_children[n * 16 + node_child_count[n]] = c
                    node_child_count[n] = node_child_count[n] + 1
                }
                expect(61, "expected ')'")
                ret n
            }
            num n = new_node(18, line) // NODE_MEMBER_ACCESS
            node_sval[n] = name
            node_rdx_type[n] = field
            ret n
        }
        
        num n = new_node(16, line) // NODE_IDENT
        node_sval[n] = name
        ret n
    }
    
    if t == 60 { // TOK_LPAREN
        advance()
        num inner = parse_expr()
        expect(61, "expected ')'")
        ret inner
    }
    
    had_error = 1
    call("" ["[RDX PARSE ERROR] line ", cur_line(), ": unexpected token '", cur_val(), "'"])
    advance()
    ret new_node(13, line)
}

make parse_primary() -> num {
    num n = parse_primary_inner()
    loop {
        if check(43) == 0 { break } // TOK_QUESTION
        num line = cur_line()
        advance()
        num prop = new_node(30, line) // NODE_PROPAGATE
        node_left[prop] = n
        n = prop
    }
    ret n
}

make parse_block() -> num {
    num line = cur_line()
    expect(62, "expected '{'") // TOK_LBRACE
    num n = new_node(19, line) // NODE_BLOCK
    loop {
        if check(63) == 1 { break } // TOK_RBRACE
        if check(70) == 1 { break } // TOK_EOF
        num s = parse_stmt()
        if s >= 0 {
            node_children[n * 16 + node_child_count[n]] = s
            node_child_count[n] = node_child_count[n] + 1
        }
    }
    expect(63, "expected '}'")
    ret n
}


make parse_stmt() -> num {
    num line = cur_line()
    num t = cur_type()
    
    if t == 10 { // TOK_RET
        advance()
        num n = new_node(3, line) // NODE_RETURN
        node_left[n] = parse_expr()
        match_tok(66) // TOK_SEMICOLON
        ret n
    }
    
    if t == 15 { // TOK_BREAK
        advance()
        num n = new_node(3, line)
        node_ival[n] = -999
        match_tok(66)
        ret n
    }
    
    if t == 38 { // TOK_CONTINUE
        advance()
        num n = new_node(24, line)
        match_tok(66)
        ret n
    }
    
    if t == 34 { // TOK_SAFE
        advance()
        num n = new_node(22, line)
        node_body[n] = parse_block()
        if check(35) == 1 { // TOK_FAIL
            advance()
            if check(45) == 1 {
                node_sval[n] = cur_val()
                advance()
            } elif check(40) == 1 { // TOK_ERR
                node_sval[n] = cur_val()
                advance()
            }
            node_else_body[n] = parse_block()
        }
        ret n
    }
    
    if t == 36 { // TOK_MATCH
        advance()
        num n = new_node(23, line)
        node_condition[n] = parse_expr()
        expect(62, "expected '{'")
        loop {
            if check(63) == 1 { break }
            if check(70) == 1 { break }
            
            num pat = -1
            if check(45) == 1 {
                if cur_val() == "_" {
                    pat = new_node(14, cur_line()) // NODE_LITERAL_STR
                    node_sval[pat] = "_"
                    advance()
                } else {
                    pat = parse_expr()
                }
            } else {
                pat = parse_expr()
            }
            expect(58, "expected '->'")
            num body_node = parse_block()
            node_children[n * 16 + node_child_count[n]] = pat
            node_child_count[n] = node_child_count[n] + 1
            node_children[n * 16 + node_child_count[n]] = body_node
            node_child_count[n] = node_child_count[n] + 1
        }
        expect(63, "expected '}'")
        ret n
    }
    
    if t == 18 { // TOK_FIX
        advance()
        num n = new_node(1, line)
        node_rdx_type[n] = "fix"
        node_sval[n] = cur_val()
        expect(45, "expected const name")
        expect(57, "expected '='")
        node_left[n] = parse_expr()
        match_tok(66)
        ret n
    }
    
    if t == 20 { // TOK_LOAD
        advance()
        num n = new_node(28, line)
        node_sval[n] = cur_val()
        expect(1, "expected str lit")
        match_tok(66)
        ret n
    }
    
    if t == 11 { // TOK_IF
        advance()
        num n = new_node(4, line) // NODE_IF
        node_condition[n] = parse_expr()
        node_body[n] = parse_block()
        if check(12) == 1 { // TOK_ELIF
            num block = new_node(19, cur_line())
            num stmt = parse_stmt()
            node_children[block * 16] = stmt
            node_child_count[block] = 1
            node_else_body[n] = block
        } elif check(13) == 1 { // TOK_ELSE
            advance()
            node_else_body[n] = parse_block()
        }
        ret n
    }
    
    if t == 12 { // TOK_ELIF (as standalone statement called from nested if)
        advance()
        num n = new_node(4, line) // NODE_IF
        node_condition[n] = parse_expr()
        node_body[n] = parse_block()
        if check(12) == 1 { // TOK_ELIF
            num block = new_node(19, cur_line())
            num stmt = parse_stmt()
            node_children[block * 16] = stmt
            node_child_count[block] = 1
            node_else_body[n] = block
        } elif check(13) == 1 { // TOK_ELSE
            advance()
            node_else_body[n] = parse_block()
        }
        ret n
    }
    
    if t == 14 { // TOK_LOOP
        advance()
        num n = new_node(5, line) // NODE_LOOP
        if check(62) == 1 {
            node_body[n] = parse_block()
        } else {
            num start_expr = parse_expr()
            if check(59) == 1 { // TOK_DOTDOT
                advance()
                num end_expr = parse_expr()
                num range = new_node(20, line) // NODE_ARRAY
                node_children[range * 16] = start_expr
                node_children[range * 16 + 1] = end_expr
                node_child_count[range] = 2
                node_condition[n] = range
                node_rdx_type[n] = "range"
                if check(22) == 1 { // TOK_AS
                    advance()
                    node_sval[n] = cur_val()
                    expect(45, "expected iter var")
                }
            } elif check(22) == 1 { // TOK_AS
                node_condition[n] = start_expr
                advance()
                node_sval[n] = cur_val()
                expect(45, "expected iter var")
                node_rdx_type[n] = "iter"
            } else {
                node_condition[n] = start_expr
            }
            node_body[n] = parse_block()
        }
        ret n
    }
    
    if t == 16 { // TOK_WHEN
        advance()
        num n = new_node(4, line) // NODE_IF
        node_rdx_type[n] = "when"
        node_condition[n] = parse_expr()
        node_body[n] = parse_block()
        ret n
    }
    
    if t == 31 { // TOK_SYS
        advance()
        expect(68, "expected '.'")
        expect(45, "expected 'rdx'")
        num n = new_node(17, line)
        node_body[n] = parse_block()
        ret n
    }
    
    if t == 32 { // TOK_CALL
        num n = parse_primary()
        match_tok(66)
        ret n
    }
    
    num is_mut = 0
    if check(19) == 1 { advance() is_mut = 1 } // TOK_MUT
    
    t = cur_type()
    num is_type = 0
    if t >= 3 { if t <= 8 { is_type = 1 } }
    
    if is_type == 1 {
        chr type_name = cur_val()
        advance()
        num n = new_node(1, line) // NODE_VAR_DECL
        node_rdx_type[n] = type_name
        if is_mut == 1 { node_ival[n] = 1 }
        
        if check(45) == 1 { // TOK_IDENT
            node_sval[n] = cur_val()
            advance()
        } else {
            node_sval[n] = type_name
        }
        
        expect(57, "expected '='") // TOK_ASSIGN
        node_left[n] = parse_expr()
        match_tok(66)
        ret n
    }
    
    if check(45) == 1 {
        if peek_type(1) == 45 {
            chr type_name = cur_val()
            advance()
            num n = new_node(1, line)
            node_rdx_type[n] = type_name
            node_sval[n] = cur_val()
            advance()
            expect(57, "expected '='")
            node_left[n] = parse_expr()
            match_tok(66)
            ret n
        }
        
        chr id_val = cur_val()
        advance()
        
        if check(68) == 1 { // TOK_DOT
            if peek_type(1) == 45 {
                if peek_type(2) == 60 { // method call
                    tok_pos = tok_pos - 1
                    num n = parse_primary()
                    match_tok(66)
                    ret n
                }
            }
            advance()
            chr field = cur_val()
            expect(45, "expected field name")
            expect(57, "expected '='")
            num n = new_node(9, line)
            node_sval[n] = id_val
            node_rdx_type[n] = field
            node_left[n] = parse_expr()
            match_tok(66)
            ret n
        }
        
        if check(64) == 1 { // TOK_LBRACKET
            advance()
            num idx_expr = parse_expr()
            expect(65, "expected ']'")
            expect(57, "expected '='")
            num n = new_node(27, line) // NODE_ARRAY_ASSIGN
            node_sval[n] = id_val
            node_left[n] = idx_expr
            node_right[n] = parse_expr()
            match_tok(66)
            ret n
        }
        
        if check(57) == 1 { // TOK_ASSIGN
            advance()
            num n = new_node(9, line) // NODE_ASSIGN
            node_sval[n] = id_val
            node_left[n] = parse_expr()
            match_tok(66)
            ret n
        }
        
        if check(60) == 1 { // TOK_LPAREN
            tok_pos = tok_pos - 1
            num n = parse_primary()
            match_tok(66)
            ret n
        }
        
        if check(43) == 1 { // TOK_QUESTION
            tok_pos = tok_pos - 1
            num n = parse_primary()
            match_tok(66)
            ret n
        }
    }
    
    had_error = 1
    call("" ["[RDX PARSE ERROR] line ", cur_line(), ": unexpected token '", cur_val(), "'"])
    advance()
    ret -1
}


make parse_fn_decl() -> num {
    num line = cur_line()
    advance()
    num n = new_node(2, line)
    chr name = cur_val()
    expect(45, "expected fn name")
    node_sval[n] = name
    
    expect(60, "expected '('")
    loop {
        if check(61) == 1 { break }
        if check(70) == 1 { break }
        if node_child_count[n] > 0 { expect(67, "expected ','") }
        num pn = new_node(1, cur_line())
        node_rdx_type[pn] = cur_val()
        advance()
        node_sval[pn] = cur_val()
        expect(45, "expected param name")
        node_children[n * 16 + node_child_count[n]] = pn
        node_child_count[n] = node_child_count[n] + 1
    }
    expect(61, "expected ')'")
    
    if check(58) == 1 {
        advance()
        node_rdx_type[n] = cur_val()
        advance()
    }
    
    node_body[n] = parse_block()
    ret n
}

make parse_program() -> num {
    num root = new_node(0, 0)
    loop {
        if check(70) == 1 { break }
        num n = -1
        if check(9) == 1 {
            n = parse_fn_decl()
        } elif check(17) == 1 {
            n = parse_shape_decl()
        } elif check(44) == 1 {
            n = parse_extern_decl()
        } else {
            n = parse_stmt()
        }
        if n >= 0 {
            node_children[root * 16 + node_child_count[root]] = n
            node_child_count[root] = node_child_count[root] + 1
        }
    }
    ret root
}


make node_name(num t) -> chr {
    if t == 0 { ret "PROGRAM" }
    if t == 1 { ret "VAR_DECL" }
    if t == 2 { ret "FN_DECL" }
    if t == 3 { ret "RETURN" }
    if t == 4 { ret "IF" }
    if t == 5 { ret "LOOP" }
    if t == 6 { ret "BLUEPRINT" }
    if t == 7 { ret "ALLOC" }
    if t == 8 { ret "DROP" }
    if t == 9 { ret "ASSIGN" }
    if t == 10 { ret "FN_CALL" }
    if t == 11 { ret "SYS_CALL" }
    if t == 12 { ret "BINARY_OP" }
    if t == 13 { ret "LIT_NUM" }
    if t == 14 { ret "LIT_STR" }
    if t == 15 { ret "LIT_FLT" }
    if t == 16 { ret "IDENT" }
    if t == 17 { ret "SYS_BLOCK" }
    if t == 18 { ret "MEMBER_ACCESS" }
    if t == 19 { ret "BLOCK" }
    if t == 20 { ret "ARRAY" }
    if t == 21 { ret "GET" }
    if t == 22 { ret "SAFE_FAIL" }
    if t == 23 { ret "MATCH" }
    if t == 24 { ret "CONTINUE" }
    if t == 25 { ret "STRUCT_LIT" }
    if t == 26 { ret "INDEX" }
    if t == 27 { ret "ARRAY_ASSIGN" }
    if t == 28 { ret "LOAD" }
    if t == 29 { ret "RESULT" }
    if t == 30 { ret "PROPAGATE" }
    if t == 31 { ret "EXTERN" }
    ret "???"
}

make parser_dump(num idx, num depth) {
    if idx < 0 { ret 0 }
    if idx >= node_count { ret 0 }
    
    chr pad = ""
    num i = 0
    loop {
        if i >= depth * 2 { break }
        pad = concat(pad, " ")
        i = i + 1
    }
    
    chr out = concat(pad, node_name(node_type[idx]))
    if node_sval[idx] != "" {
        out = concat(out, " \"")
        out = concat(out, node_sval[idx])
        out = concat(out, "\"")
    }
    if node_ival[idx] != 0 {
        out = concat(out, " ival=")
        out = concat(out, str(node_ival[idx]))
    }
    if node_op[idx] != "" {
        out = concat(out, " op=")
        out = concat(out, node_op[idx])
    }
    if node_rdx_type[idx] != "" {
        out = concat(out, " type=")
        out = concat(out, node_rdx_type[idx])
    }
    call(out)
    
    if node_condition[idx] >= 0 { parser_dump(node_condition[idx], depth + 1) }
    if node_left[idx] >= 0 { parser_dump(node_left[idx], depth + 1) }
    if node_right[idx] >= 0 { parser_dump(node_right[idx], depth + 1) }
    if node_body[idx] >= 0 { parser_dump(node_body[idx], depth + 1) }
    if node_else_body[idx] >= 0 { parser_dump(node_else_body[idx], depth + 1) }
    
    num c = 0
    loop {
        if c >= node_child_count[idx] { break }
        parser_dump(node_children[idx * 16 + c], depth + 1)
        c = c + 1
    }
}

sys.rdx {
    chr source_code = "shape Vector2 { flt x; flt y; }\nextern \"math.dll\" make sqrt(flt x) -> flt;\nmake main(num a, chr b) -> num {\n    mut num x = 20;\n    flt y = 3.14;\n    chr s = \"hello\";\n    if x == 10 {\n        ret 1;\n    } elif x > 5 {\n        ret 2;\n    } else {\n        ret 3;\n    }\n    loop 0..10 as i {\n        if i == 5 { break; }\n        continue;\n    }\n    safe {\n        call(\"trying\");\n    } fail err {\n        call(\"failed\");\n    }\n    match x {\n        10 -> { ret 1; }\n        _ -> { ret 0; }\n    }\n    Vector2 v = Vector2 { x: 1.0, y: 2.0 };\n    v.x = 5.0;\n    num arr = [1, 2, 3];\n    arr[0] = 5;\n    num n = ok(10);\n    n?;\n    sys.rdx { call(\"sys\"); }\n    load \"module.rdx\";\n    fix CONST = 100;\n}\n"
    tokenize(source_code)
    num root = parse_program()
    call("=== AST ===")
    parser_dump(root, 0)
}
