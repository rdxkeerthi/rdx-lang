    if c == "B" { ret 1 }
    if c == "C" { ret 1 }
    if c == "D" { ret 1 }
    if c == "E" { ret 1 }
    if c == "F" { ret 1 }
    if c == "G" { ret 1 }
    if c == "H" { ret 1 }
    if c == "I" { ret 1 }
    if c == "J" { ret 1 }
    if c == "K" { ret 1 }
    if c == "L" { ret 1 }
    if c == "M" { ret 1 }
    if c == "N" { ret 1 }
    if c == "O" { ret 1 }
    if c == "P" { ret 1 }
    if c == "Q" { ret 1 }
    if c == "R" { ret 1 }
    if c == "S" { ret 1 }
    if c == "T" { ret 1 }
    if c == "U" { ret 1 }
    if c == "V" { ret 1 }
    if c == "W" { ret 1 }
    if c == "X" { ret 1 }
    if c == "Y" { ret 1 }
    if c == "Z" { ret 1 }
    if c == "_" { ret 1 }
    ret 0
}
make is_alnum(chr c) -> num { if is_alpha(c) == 1 { ret 1 } if is_digit(c) == 1 { ret 1 } ret 0 }

make tokenize(chr src) {
    num length = len(src)
    num pos = 0
    num token_count = 0
    num line = 1
    loop {
        if (pos >= length) { break }
        chr current = chr_at(src, pos)
        num handled = 0
        if handled == 0 {
            if is_space(current) == 1 {
                if current == "\n" { line = line + 1 }
                pos = pos + 1
                handled = 1
            }
        }
        if handled == 0 {
            if current == "/" {
                if (pos + 1 < length) {
                    chr next = chr_at(src, pos + 1)
                    if next == "/" {
                        loop {
                            if (pos >= length) { break }
                            chr c = chr_at(src, pos)
                            if c == "\n" { break }
                            pos = pos + 1
                        }
                        handled = 1
                    }
                }
            }
        }
        num cur_line = line
        if handled == 0 {
            if current == "\"" {
                pos = pos + 1
                chr str_val = ""
                loop {
                    if (pos >= length) { break }
                    chr c = chr_at(src, pos)
                    if c == "\"" { pos = pos + 1 break }
                    if c == "\n" { line = line + 1 }
                    str_val = concat(str_val, c)
                    pos = pos + 1
                }
                tok_type[token_count] = 1 // STR_LIT
                tok_val[token_count] = str_val
                tok_line[token_count] = cur_line
                token_count = token_count + 1
                handled = 1
            }
        }
        if handled == 0 {
            if is_digit(current) == 1 {
                num is_flt = 0
                chr num_val = ""
                loop {
                    if (pos >= length) { break }
                    chr n = chr_at(src, pos)
                    num done_digit = 0
                    if is_digit(n) == 1 {
                        num_val = concat(num_val, n)
                        pos = pos + 1
                        done_digit = 1
                    }
                    if done_digit == 0 {
                        if n == "." {
                            if (pos + 1 < length) {
                                chr n2 = chr_at(src, pos + 1)
                                if n2 != "." {
                                    if is_digit(n2) == 1 {
                                        is_flt = 1
                                        num_val = concat(num_val, n)
                                        num_val = concat(num_val, n2)
                                        pos = pos + 2
                                        done_digit = 1
                                    }
                                }
                            }
                        }
                    }
                    if done_digit == 0 { break }
                }
                if is_flt == 1 {
                    tok_type[token_count] = 2 // FLT_LIT
                } else {
                    tok_type[token_count] = 0 // NUM_LIT
                }
                tok_val[token_count] = num_val
                tok_line[token_count] = cur_line
                token_count = token_count + 1
                handled = 1
            }
        }
        if handled == 0 {
            if is_alpha(current) == 1 {
                num start = pos
                num start_line = cur_line
                chr c0 = current
                chr id_val = ""
                loop {
                    if (pos >= length) { break }
                    chr n = chr_at(src, pos)
                    if is_alnum(n) == 0 { break }
                    id_val = concat(id_val, n)
                    pos = pos + 1
                }
                num len_val = pos - start
            num is_kw = 0
            if (start + 0 < length) {
              if c0 == "n" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "u" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "m" {
                  if len_val == 3 {
                    tok_type[token_count] = 3
                    tok_val[token_count] = "num"
                    tok_line[token_count] = start_line
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "c" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "h" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "r" {
                  if len_val == 3 {
                    tok_type[token_count] = 4
                    tok_val[token_count] = "chr"
                    tok_line[token_count] = start_line
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "f" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "l" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "t" {
                  if len_val == 3 {
                    tok_type[token_count] = 5
                    tok_val[token_count] = "flt"
                    tok_line[token_count] = start_line
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "b" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "l" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "o" {
                  if len_val == 3 {
                    tok_type[token_count] = 6
                    tok_val[token_count] = "blo"
                    tok_line[token_count] = start_line
                    is_kw = 1
                  }
                  }
                }
                }
              }
              }
            }
            if (start + 0 < length) {
              if c0 == "d" {
              if (start + 1 < length) {
                if chr_at(src, start + 1) == "o" {
                if (start + 2 < length) {
                  if chr_at(src, start + 2) == "b" {
