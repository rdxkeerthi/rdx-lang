-1,-1,-1,-1,-1,-1,-1]

mut num node_count = 0

make is_digit(chr c) -> num {
    if c == "0" { ret 1 }
    if c == "1" { ret 1 }
    if c == "2" { ret 1 }
    if c == "3" { ret 1 }
    if c == "4" { ret 1 }
    if c == "5" { ret 1 }
    if c == "6" { ret 1 }
    if c == "7" { ret 1 }
    if c == "8" { ret 1 }
    if c == "9" { ret 1 }
    ret 0
}
make is_space(chr c) -> num { if c == " " { ret 1 } if c == "\n" { ret 1 } if c == "\r" { ret 1 } if c == "\t" { ret 1 } ret 0 }
make is_alpha(chr c) -> num {
    if c == "a" { ret 1 }
    if c == "b" { ret 1 }
    if c == "c" { ret 1 }
    if c == "d" { ret 1 }
    if c == "e" { ret 1 }
    if c == "f" { ret 1 }
    if c == "g" { ret 1 }
    if c == "h" { ret 1 }
    if c == "i" { ret 1 }
    if c == "j" { ret 1 }
    if c == "k" { ret 1 }
    if c == "l" { ret 1 }
    if c == "m" { ret 1 }
    if c == "n" { ret 1 }
    if c == "o" { ret 1 }
    if c == "p" { ret 1 }
    if c == "q" { ret 1 }
    if c == "r" { ret 1 }
    if c == "s" { ret 1 }
    if c == "t" { ret 1 }
    if c == "u" { ret 1 }
    if c == "v" { ret 1 }
    if c == "w" { ret 1 }
    if c == "x" { ret 1 }
    if c == "y" { ret 1 }
    if c == "z" { ret 1 }
