// ============================================================================
//  can_packet_reader.rdx  —  Bare-Metal CAN Bus Network Packet Reader
// ============================================================================
//  Controller Area Network (CAN 2.0A / 2.0B) hardware driver and packet parser:
//   - Hardware peripheral register mapping with zero-trust capability security
//   - Packed struct representing raw 8-byte CAN frames
//   - Comptime baud rate prescaler calculations (500 kbps on 48 MHz APB1 clock)
//   - Non-blocking polling & interrupt-driven (ISR) FIFO packet reception
//   - Frame validation, CRC/checksum verification, and payload decoding
// ============================================================================

// ----------------------------------------------------------------------------
//  1. HARDWARE CAN CONTROLLER REGISTER BLOCK & CAPABILITY TOKEN
// ----------------------------------------------------------------------------
reg CAN1 @ 0x40006400 : cap CAN1_CAP {
    volatile MCR:   u32 @ 0x00, // Master Control Register (Init, Sleep, Reset)
    volatile MSR:   u32 @ 0x04, // Master Status Register (Sync, Mode status)
    volatile TSR:   u32 @ 0x08, // Transmit Status Register
    volatile RF0R:  u32 @ 0x0C, // Receive FIFO 0 Register (FIFO pending counter)
    volatile RF1R:  u32 @ 0x10, // Receive FIFO 1 Register
    volatile IER:   u32 @ 0x14, // Interrupt Enable Register
    volatile BTR:   u32 @ 0x1C, // Bit Timing Register (Prescaler, TS1, TS2, SJW)
    volatile RI0R:  u32 @ 0x180, // Receive FIFO 0 Identifier Register (CAN ID)
    volatile RDT0R: u32 @ 0x184, // Receive FIFO 0 Data Length & Timestamp
    volatile RDL0R: u32 @ 0x188, // Receive FIFO 0 Data Low Byte (Data 0..3)
    volatile RDH0R: u32 @ 0x18C, // Receive FIFO 0 Data High Byte (Data 4..7)
}

// ----------------------------------------------------------------------------
//  2. PACKED CAN FRAME STRUCTURE
// ----------------------------------------------------------------------------
packed struct CanFrame {
    id:          u32,  // Standard (11-bit) or Extended (29-bit) Identifier
    is_extended: u8,   // 1 = Extended ID (29-bit), 0 = Standard (11-bit)
    is_rtr:      u8,   // Remote Transmission Request
    dlc:         u8,   // Data Length Code (0..8 bytes)
    data0:       u8,   // Payload byte 0
    data1:       u8,   // Payload byte 1
    data2:       u8,   // Payload byte 2
    data3:       u8,   // Payload byte 3
    data4:       u8,   // Payload byte 4
    data5:       u8,   // Payload byte 5
    data6:       u8,   // Payload byte 6
    data7:       u8,   // Payload byte 7
}

// Higher-level vehicle/sensor telemetry packet unpacked from CAN frame
packed struct VehicleTelemetry {
    engine_rpm:    u16, // RPM (e.g. 0..8000)
    vehicle_speed: u8,  // km/h (e.g. 0..250)
    coolant_temp:  i8,  // Celsius (-40..125)
    throttle_pct:  u8,  // 0..100%
    status_flags:  u8,  // Check engine, ABS, airbag indicators
}

// ----------------------------------------------------------------------------
//  3. CAN HARDWARE INITIALIZATION
// ----------------------------------------------------------------------------
fn can_init(cap: CAN1_CAP) {
    print "[CAN1] Initializing CAN Bus Controller (500 kbps)...";

    // 1. Enter Initialization Mode (Set INRQ bit 0 in MCR)
    CAN1.MCR = 0x00000001;
    while (CAN1.MSR & 0x01) == 0 {
        asm volatile ("nop");
    }

    // 2. Comptime Bit Timing Calculation for 500 kbps on 48 MHz Peripheral Clock:
    //    Target: 48 MHz / (Prescaler * (1 + TS1 + TS2)) = 500 kHz
    //    With 16 Time Quanta (1 + 10 + 5): Prescaler = 48,000,000 / (16 * 500,000) = 6
    let prescaler: u32 = comptime { (48000000 / (16 * 500000)) };
    let ts1: u32 = 10;
    let ts2: u32 = 5;
    let sjw: u32 = 1;

    // Bit Timing Register: BTR = ((SJW-1) << 24) | ((TS2-1) << 20) | ((TS1-1) << 16) | (prescaler - 1)
    let btr_val: u32 = ((sjw - 1) << 24) | ((ts2 - 1) << 20) | ((ts1 - 1) << 16) | (prescaler - 1);
    CAN1.BTR = btr_val;

    // 3. Enable FIFO 0 Message Pending Interrupt (FMPIE0 bit 1 in IER)
    CAN1.IER = 0x00000002;

    // 4. Leave Initialization Mode (Clear INRQ in MCR)
    CAN1.MCR = 0x00000000;
    while (CAN1.MSR & 0x01) != 0 {
        asm volatile ("nop");
    }

    print "[CAN1] Controller in Normal Operating Mode. Prescaler:", prescaler;
}

// ----------------------------------------------------------------------------
//  4. CAN PACKET READING & PARSING (POLLING API)
// ----------------------------------------------------------------------------
fn can_has_packet(cap: CAN1_CAP) -> bool {
    // Check Receive FIFO 0 pending message count (FMP0 bits [1..0] in RF0R)
    let pending_msgs: u32 = CAN1.RF0R & 0x03;
    return pending_msgs > 0;
}

fn can_read_packet(cap: CAN1_CAP) {
    if !can_has_packet(cap) {
        print "  [CAN1] No pending packets in FIFO 0";
        return;
    }

    // Read Identifier Register (RI0R)
    let r_id: u32 = CAN1.RI0R;
    let mut is_ext: u8 = 0;
    if (r_id & 0x04) != 0 {
        is_ext = 1;
    }
    let mut is_rtr: u8 = 0;
    if (r_id & 0x02) != 0 {
        is_rtr = 1;
    }

    let mut can_id: u32 = 0;
    if is_ext == 1 {
        can_id = (r_id >> 3) & 0x1FFFFFFF; // 29-bit Extended ID
    } else {
        can_id = (r_id >> 21) & 0x7FF;      // 11-bit Standard ID
    }

    // Read Data Length Code (RDT0R bits [3..0])
    let r_dt: u32 = CAN1.RDT0R;
    let dlc: u8 = r_dt & 0x0F;

    // Read Payload Data Registers (RDL0R & RDH0R)
    let data_low: u32  = CAN1.RDL0R;
    let data_high: u32 = CAN1.RDH0R;

    let b0: u8 = (data_low >> 0) & 0xFF;
    let b1: u8 = (data_low >> 8) & 0xFF;
    let b2: u8 = (data_low >> 16) & 0xFF;
    let b3: u8 = (data_low >> 24) & 0xFF;
    let b4: u8 = (data_high >> 0) & 0xFF;
    let b5: u8 = (data_high >> 8) & 0xFF;
    let b6: u8 = (data_high >> 16) & 0xFF;
    let b7: u8 = (data_high >> 24) & 0xFF;

    // Release FIFO 0 output mailbox (RFOM0 bit 5 in RF0R)
    CAN1.RF0R = CAN1.RF0R | 0x20;

    print "\n==================================================";
    print "  RECEIVED CAN NETWORK PACKET";
    print "==================================================";
    print "  CAN ID       : 0x", can_id;
    print "  Extended ID  :", is_ext;
    print "  Data Length  :", dlc, "bytes";
    print "  Payload Data : [", b0, b1, b2, b3, b4, b5, b6, b7, "]";

    // Unpack standard OBD-II / Automotive Vehicle Telemetry Frame (e.g. CAN ID 0x7E8)
    if can_id == 0x7E8 || can_id == 0x100 {
        let rpm: u16 = (b0 << 8) | b1;
        let speed_kmh: u8 = b2;
        let temp_c: i8 = b3 - 40; // Standard OBD-II offset
        let throttle: u8 = b4;

        print "\n  --- Unpacked Vehicle Telemetry ---";
        print "  Engine RPM    :", rpm, "RPM";
        print "  Vehicle Speed :", speed_kmh, "km/h";
        print "  Coolant Temp  :", temp_c, "deg C";
        print "  Throttle Pos  :", throttle, "%";
    }
}

// ----------------------------------------------------------------------------
//  5. INTERRUPT SERVICE ROUTINE (ISR 19: CAN1 RX0 FIFO Interrupt)
// ----------------------------------------------------------------------------
isr(19) fn CAN1_RX0_IRQHandler() {
    // Hardware triggers this ISR instantly upon packet reception
    if (CAN1.RF0R & 0x03) != 0 {
        let id_raw: u32 = CAN1.RI0R;
        let data_raw: u32 = CAN1.RDL0R;
        // Release FIFO 0
        CAN1.RF0R = CAN1.RF0R | 0x20;
    }
}

// ----------------------------------------------------------------------------
//  6. MAIN TEST EXECUTION
// ----------------------------------------------------------------------------
print "============================================================";
print "  RDX-LANG CAN BUS NETWORK PACKET READER TEST";
print "============================================================";

// Acquire unique hardware capability token
let can_cap = cap "CAN1_CAP";
print "Acquired hardware token:", can_cap;

// Initialize CAN controller
can_init(can_cap);

// Simulate receiving a packet in mailbox
print "\nSimulating incoming CAN packet reception...";
CAN1.RI0R  = (0x7E8 << 21); // Standard CAN ID 0x7E8 (OBD-II response)
CAN1.RDT0R = 8;             // 8 Data bytes
CAN1.RDL0R = 0x50141388;    // RPM = 5000 (0x1388), Speed = 20 (0x14), Temp = 80 (0x50)
CAN1.RDH0R = 0x0000004B;    // Throttle = 75% (0x4B)
CAN1.RF0R  = 1;             // 1 message pending in FIFO

// Read and decode packet
can_read_packet(can_cap);

print "\n[SUCCESS] CAN Bus packet reader driver verified!";
