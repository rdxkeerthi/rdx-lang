shape Vector2 { flt x; flt y; }
extern "math.dll" make sqrt(flt x) -> flt;
make main(num a, chr b) -> num {
    mut num x = 20;
    flt y = 3.14;
    chr s = "hello";
    if x == 10 {
        ret 1;
    } elif x > 5 {
        ret 2;
    } else {
        ret 3;
    }
    loop 0..10 as i {
        if i == 5 { break; }
        continue;
    }
    safe {
        call("trying");
    } fail err {
        call("failed");
    }
    match x {
        10 -> { ret 1; }
        _ -> { ret 0; }
    }
    Vector2 v = Vector2 { x: 1.0, y: 2.0 };
    v.x = 5.0;
    num arr = [1, 2, 3];
    arr[0] = 5;
    num n = ok(10);
    n?;
    sys.rdx { call("sys"); }
    load "module.rdx";
    fix CONST = 100;
}
